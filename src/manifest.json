{
  "manifest_version": 3,
  "name": "Element Copy 元素复制",
  "version": "1.0.0",
  "description": "拾取页面任意元素，复制富文本/纯文本，右键插件图标切换模式，Esc退出",
  "permissions": ["clipboardWrite", "storage", "contextMenus"],
  "action": {},
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ]
}
